{
	"name": "crush",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vp dev",
		"build": "vp build",
		"preview": "vp preview",
		"deploy": "vp build && vp exec wrangler deploy",
		"deploy:dry": "vp build && vp exec wrangler deploy --dry-run",
		"prepare": "vp config && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "vp fmt --check .",
		"format": "vp fmt ."
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@vite-pwa/sveltekit": "^1.1.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "catalog:",
		"vite-plugin-pwa": "^1.3.0",
		"vite-plus": "catalog:",
		"workbox-window": "^7.4.1",
		"wrangler": "^4.105.0"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.9.0",
			"onFail": "download"
		}
	},
	"engines": {
		"node": "^20.19.0 || ^22.18.0 || >=24.11.0"
	},
	"dependencies": {
		"@jsquash/avif": "^2.1.1",
		"@jsquash/oxipng": "^2.3.0",
		"@phosphor-icons/web": "^2.1.2",
		"fflate": "^0.8.3"
	}
}
